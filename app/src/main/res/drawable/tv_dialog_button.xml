<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#181E21" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#24383E" /><corners android:radius="12dp" /><stroke android:width="3dp" android:color="#68C9DD" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#294148" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#1B2327" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
